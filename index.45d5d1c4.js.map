"use strict";
document.addEventListener("DOMContentLoaded", function() {
    var field = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    var calculatedTop = (field.clientHeight - spider.clientHeight) / 2 + "px";
    var calculatedLeft = (field.clientWidth - spider.clientWidth) / 2 + "px";
    spider.style.position = "absolute";
    spider.style.top = calculatedTop;
    spider.style.left = calculatedLeft;
});

